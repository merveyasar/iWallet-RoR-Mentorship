<% flash.each do |type, message| %>
  <% 
    # Duruma göre renk ve ikon ayarları
    is_success = (type == 'notice' || type == 'success')
    icon_color = is_success ? 'text-green-500' : 'text-red-500'
    border_color = is_success ? 'border-green-100' : 'border-red-100'
  %>

  <div
    data-controller="notification"
    data-notification-delay-value="6000"
    <%# 'hidden' sınıfını kaldırdık, paket kendi hallediyor %>
    class="fixed top-5 right-5 z-50 flex items-start gap-4 p-5 bg-white rounded-xl shadow-lg border <%= border_color %> min-w-[24rem] transition transform duration-1000 hidden"
    
    <%# Animasyon Sınıfları %>
    data-transition-enter-from="opacity-0 translate-y-2 sm:translate-y-0 sm:translate-x-6"
    data-transition-enter-to="opacity-100 translate-x-0"
    data-transition-leave-from="opacity-100 translate-x-0"
    data-transition-leave-to="opacity-0 translate-x-6"
  >
    <%# Dinamik İkon (Başarı: Tik, Hata: Ünlem) %>
    <div class="flex-shrink-0">
      <% if is_success %>
        <svg class="h-6 w-6 <%= icon_color %>" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      <% else %>
        <svg class="h-6 w-6 <%= icon_color %>" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
        </svg>
      <% end %>
    </div>

    <%# Metin Alanı %>
    <div class="flex-1">
      <h3 class="text-sm font-bold text-slate-900 leading-none">
        <%= is_success ? 'Başarılı' : 'Hata Oluştu' %>
      </h3>
      <p class="text-sm text-slate-500 mt-2">
        <%= message %>
      </p>
    </div>

    <%# Kapatma Butonu %>
    <button 
      data-action="notification#hide" 
      type="button" 
      class="text-slate-400 hover:text-slate-600 focus:outline-none"
    >
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
<% end %>